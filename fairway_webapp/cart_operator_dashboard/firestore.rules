rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasV2Access() {
      return request.auth != null
        && exists(/databases/$(database)/documents/user_access/$(request.auth.uid))
        && get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.schema_version == 2
        && get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.admin is bool
        && get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.course_ids is list
        && (
          (
            get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.admin == true
            && get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.customer_id == null
            && get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.course_ids.size() == 0
          )
          || (
            get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.admin == false
            && get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.customer_id is string
          )
        );
    }

    match /requests/{requestId} {
      allow read: if hasV2Access() && (
          get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.admin == true
          || (
            get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.admin == false
            && get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.customer_id == resource.data.customer_id
            && (
              get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.course_ids.size() == 0
              || resource.data.course_id in get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.course_ids
            )
          )
        );
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}