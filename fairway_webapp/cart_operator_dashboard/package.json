{
  "name": "cart-operator-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 test/*.browser.mjs",
    "test:qr:browser": "test -n \"$FAIRWAY_QR_FIXTURE\" || { echo 'Set FAIRWAY_QR_FIXTURE to the private synthetic sandbox fixture'; exit 1; }; node --test --test-concurrency=1 test/qrBaySides.browser.mjs test/qrCourse.browser.mjs",
    "validate:sandbox": "node --env-file-if-exists=.env.sandbox scripts/validate_frontend_config.js",
    "validate:production": "node --env-file-if-exists=.env.production scripts/validate_frontend_config.js",
    "dev:sandbox": "npm run validate:sandbox && vite --mode sandbox --host 0.0.0.0",
    "build:sandbox": "npm run validate:sandbox && vite build --mode sandbox",
    "build:production": "npm run validate:production && vite build --mode production",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "exceljs": "4.4.0",
    "firebase": "^12.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
