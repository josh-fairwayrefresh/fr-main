source "Kconfig.zephyr"

menu "Fairway firmware"

config FAIRWAY_USB_COMMISSIONING
	bool "Build the USB-only commissioning application instead of the operational runtime"
	depends on UART_INTERRUPT_DRIVEN
	default n
	help
	  Keeps the onboard debugger powered, receives buffered commissioning
	  transactions, and writes identity only through TF-M Protected Storage.
	  Never starts LTE, golfer transactions, or OTA scheduling.

config FAIRWAY_OTA
	bool "Enable MCUboot OTA staging and trial lifecycle"
	depends on DFU_TARGET_MCUBOOT
	default y
	help
	  Enables the transport-independent update staging API and MCUboot
	  test-boot confirmation lifecycle. It does not start network activity.

if FAIRWAY_OTA

config FAIRWAY_OTA_HARDWARE_ID
	string "Signed update target hardware identifier"
	default "circuitdojo_feather_nrf9151@1/nrf9151/ns"

config FAIRWAY_OTA_TRIAL_TIMEOUT_SECONDS
	int "Maximum time to confirm a trial image"
	range 30 600
	default 300
	help
	  Bounds normal-mode trial health evaluation. The Nordic modem library
	  documents that initialization can take a few minutes when modem
	  firmware update work is already scheduled. LTE registration and
	  backend availability are not part of this deadline. Service mode
	  does not arm the deadline.

config FAIRWAY_OTA_FIRMWARE_VERSION
	string "Firmware semantic version reported by this image"
	default "0.1.0+1"

config FAIRWAY_OTA_INITIAL_CHECK_DELAY_SECONDS
	int "Delay before the first one-time firmware check"
	range 60 86400
	default 900

choice FAIRWAY_OTA_SCHEDULE
	prompt "Firmware check schedule"
	default FAIRWAY_OTA_SCHEDULE_ONE_TIME

config FAIRWAY_OTA_SCHEDULE_ONE_TIME
	bool "One-time initial check"

config FAIRWAY_OTA_SCHEDULE_NIGHTLY
	bool "Nightly course-local check"

endchoice

endif

endmenu
